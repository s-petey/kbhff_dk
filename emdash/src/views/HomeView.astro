---
/** Home page, shared by `/` and `/en/`. */
import { getEmDashCollection, getSiteSettings } from "emdash";
import Button from "../components/kbhff/Button.astro";
import { getMessages, resolveLocale } from "../i18n";
import { newsListPath } from "../i18n/routes";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import PostGrid from "./PostGrid.astro";

const locale = resolveLocale(Astro.currentLocale);
const t = getMessages(locale).news;
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 6,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
---

<Base title={siteTitle} description={siteTagline} locale={locale}>
	<div class="stack home">
		<h1>{siteTitle}</h1>
		<h2>{t.latest}</h2>
		{posts.length > 0 ? <PostGrid posts={posts} locale={locale} /> : <p class="text-muted">{t.empty}</p>}
		<div>
			<Button href={newsListPath(locale)} variant="secondary">{t.title} →</Button>
		</div>
	</div>
</Base>

<style>
	.home {
		--stack-gap: 1.5rem;
	}
</style>
