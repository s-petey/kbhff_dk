---
/**
 * News list, shared by `/nyheder` and `/en/news`.
 *
 * - Title and intro come from the CMS page whose slug is the news path segment
 *   (`nyheder` in Danish, `news` in English; linked as translations).
 * - Search (EmDash full-text search in the page's language) and filter by
 *   category and/or tag, with translated query parameters:
 *   `/nyheder?q=…&kategori=…&tag=…`, `/en/news?search=…&category=…&tag=…`.
 *   Term values are the slugs in the page's language; unknown ones are ignored.
 *   Matches are listed by date like the rest of the list; at most the 200 best.
 * - The language link keeps the search and the filters when every filter term
 *   has a translation (same translation group), otherwise only the search.
 */
import { getEmDashCollection, getEmDashEntry, getTaxonomyTermsWithCacheHint, getTermsForEntries, search } from "emdash";
import type { TaxonomyTerm } from "emdash";
import { PortableText } from "emdash/ui";
import Button from "../components/kbhff/Button.astro";
import { getMessages, otherLocale, resolveLocale } from "../i18n";
import {
	newsListPath,
	newsSegment,
	newsTaxonomies,
	readNewsFilters,
	type NewsFilters,
	type NewsTaxonomy,
} from "../i18n/routes";
import Base from "../layouts/Base.astro";
import PostGrid from "./PostGrid.astro";

const locale = resolveLocale(Astro.currentLocale);
const target = otherLocale(locale);
const t = getMessages(locale).news;
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const groupLabels: Record<NewsTaxonomy, string> = { category: t.categories, tag: t.tags };

const [introResult, ...termResults] = await Promise.all([
	getEmDashEntry("pages", newsSegment[locale], { locale }),
	...newsTaxonomies.map((taxonomy) => getTaxonomyTermsWithCacheHint(taxonomy, { locale })),
]);
const intro = introResult.entry;
const terms = Object.fromEntries(
	newsTaxonomies.map((taxonomy, index) => [taxonomy, termResults[index]!.data]),
) as Record<NewsTaxonomy, TaxonomyTerm[]>;

// Keep the search text, and only the filters that name an existing term.
const requested = readNewsFilters(Astro.url.searchParams, locale);
const filters: NewsFilters = { search: requested.search };
const activeTerms: [NewsTaxonomy, TaxonomyTerm][] = [];
for (const taxonomy of newsTaxonomies) {
	const term = terms[taxonomy].find((item) => item.slug === requested[taxonomy]);
	if (term) {
		filters[taxonomy] = term.slug;
		activeTerms.push([taxonomy, term]);
	}
}

// Search returns the matching post ids; the query below lists those posts.
// An empty id list would not filter at all, so no matches skips the query.
const matchIds = filters.search
	? (await search(filters.search, { collections: ["posts"], locale, limit: 200 })).items.map((item) => item.id)
	: undefined;
const where: Record<string, string | string[]> = Object.fromEntries(activeTerms.map(([taxonomy, term]) => [taxonomy, term.slug]));
if (matchIds) where.id = matchIds;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = matchIds?.length === 0
	? { entries: [], cacheHint: undefined, nextCursor: undefined }
	: await getEmDashCollection("posts", {
			locale,
			where,
			orderBy: { published_at: "desc" },
			limit: 20,
			cursor,
		});
if (Astro.cache?.enabled) {
	Astro.cache.set(introResult.cacheHint);
	for (const result of termResults) Astro.cache.set(result.cacheHint);
	if (cacheHint) Astro.cache.set(cacheHint);
}

// One batched query for every post's tags instead of one per post.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"tag",
);

// The same search and filters in the other language when every filter term is
// translated, otherwise only the search. Only filtered views need the other
// language's terms.
const translatedTerms = await Promise.all(
	activeTerms.map(async ([taxonomy, term]) => {
		const other = await getTaxonomyTermsWithCacheHint(taxonomy, { locale: target, includeCounts: false });
		if (Astro.cache?.enabled) Astro.cache.set(other.cacheHint);
		const match = term.translationGroup
			? other.data.find((item) => item.translationGroup === term.translationGroup)
			: undefined;
		return [taxonomy, match?.slug] as const;
	}),
);
const targetFilters: NewsFilters = translatedTerms.every(([, slug]) => slug)
	? { search: filters.search, ...Object.fromEntries(translatedTerms) }
	: { search: filters.search };

const title = intro?.data.title ?? t.title;
const filterGroups = newsTaxonomies.map((taxonomy) => ({
	taxonomy,
	label: groupLabels[taxonomy],
	terms: terms[taxonomy].filter((term) => (term.count ?? 0) > 0),
}));
const filtered = activeTerms.length > 0 || Boolean(filters.search);
---

<Base
	title={title}
	locale={locale}
	languageLink={{ locale: target, href: newsListPath(target, targetFilters) }}
	searchFilters={filters}
>
	<div class="stack news">
		<h1 {...intro?.edit.title}>{title}</h1>
		{intro && <PortableText value={intro.data.content} />}

		<nav class="stack filters" aria-label={t.filters}>
			<div class="cluster">
				<Button href={newsListPath(locale)} variant="secondary" size="sm" aria-current={filtered ? undefined : "page"}>
					{t.allNews}
				</Button>
			</div>
			{
				filterGroups.map(
					({ taxonomy, label, terms: groupTerms }) =>
						groupTerms.length > 0 && (
							<div class="cluster" role="group" aria-label={label}>
								{groupTerms.map((term) => {
									const active = filters[taxonomy] === term.slug;
									// The active term's link removes that filter; others replace it.
									const href = newsListPath(locale, { ...filters, [taxonomy]: active ? undefined : term.slug });
									return (
										<Button href={href} variant="secondary" size="sm" aria-current={active ? "true" : undefined}>
											{term.label}
										</Button>
									);
								})}
							</div>
						),
				)
			}
		</nav>

		{
			posts.length > 0 ? (
				<PostGrid posts={posts} locale={locale} tagsByEntry={tagsByEntry} />
			) : (
				<p class="text-muted">{filtered ? t.emptyFiltered : t.empty}</p>
			)
		}

		{
			(cursor || nextCursor) && (
				<nav class="cluster" aria-label={t.pagination}>
					{cursor && (
						<Button href={newsListPath(locale, filters)} variant="secondary">
							{t.firstPage}
						</Button>
					)}
					{nextCursor && (
						<Button href={newsListPath(locale, filters, nextCursor)} variant="secondary">
							{t.nextPage}
						</Button>
					)}
				</nav>
			)
		}
	</div>
</Base>

<style>
	.news {
		--stack-gap: 1.5rem;
	}

	.filters {
		--stack-gap: 0.75rem;
	}
</style>
