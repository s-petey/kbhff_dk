---
/**
 * Suggests the other language when the browser's preferred language does not
 * match the page:
 *   - on Danish (default-locale) pages: when the browser's first language is
 *     not Danish, offer English (the international fallback);
 *   - on English pages: when the browser's first language is Danish, offer Danish.
 *
 * Never redirects. It runs in the browser (`navigator.languages`), so the HTML
 * is identical for every visitor and stays cacheable. The text is in the
 * *target* language, since the visitor may not read the current one.
 * Dismissal is remembered per browser. It is a fixed bar at the bottom, not a
 * dialog, so it never shifts the layout or blocks the page.
 */
import { defaultLocale, getMessages, type Locale } from "../../i18n";
import type { LanguageLinkTarget } from "../../i18n/routes";
import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
	pageLocale: Locale;
	languageLink: LanguageLinkTarget;
	/** Styleguide only: render visible and in the page flow, without the script hooks. */
	preview?: boolean;
}

const { pageLocale, languageLink, preview = false } = Astro.props;
const t = getMessages(languageLink.locale).languageBanner;
---

<aside
	class:list={["language-banner", { preview }]}
	lang={languageLink.locale}
	aria-label={t.region}
	data-language-banner={preview ? undefined : ""}
	data-page-locale={pageLocale}
	data-target-locale={languageLink.locale}
	data-default-locale={defaultLocale}
	hidden={!preview}
>
	<p>{t.message}</p>
	<div class="actions">
		<Button href={languageLink.href} size="sm">{t.action}</Button>
		<button type="button" class="dismiss" aria-label={t.dismiss} data-language-banner-dismiss>
			<Icon name="close" size={18} />
		</button>
	</div>
</aside>

<script>
	const STORAGE_KEY = "kbhff-language-banner-dismissed";
	const banner = document.querySelector<HTMLElement>("[data-language-banner]");

	if (banner) {
		const { pageLocale, targetLocale, defaultLocale } = banner.dataset;
		const preferred = (navigator.languages?.[0] ?? navigator.language ?? "").toLowerCase().split("-")[0];

		const suggest =
			preferred !== "" &&
			(pageLocale === defaultLocale ? preferred !== pageLocale : preferred === targetLocale);

		let dismissed = false;
		try {
			dismissed = localStorage.getItem(STORAGE_KEY) === "1";
		} catch {
			// Storage can be unavailable (private mode, blocked site data).
		}

		if (suggest && !dismissed) banner.hidden = false;

		banner.querySelector("[data-language-banner-dismiss]")?.addEventListener("click", () => {
			banner.hidden = true;
			try {
				localStorage.setItem(STORAGE_KEY, "1");
			} catch {
				// Ignore; it stays hidden for this page view.
			}
		});
	}
</script>

<style>
	.language-banner {
		position: fixed;
		inset: auto 1rem 1rem;
		z-index: 50;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		max-width: 40rem;
		margin-inline: auto;
		padding: 0.75rem 0.75rem 0.75rem 1.25rem;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 18%);
	}

	.language-banner[hidden] {
		display: none;
	}

	.preview {
		position: static;
		margin-inline: 0;
	}

	p {
		margin: 0;
		font-weight: 600;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.dismiss {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		color: var(--color-text-muted);
		background: transparent;
		cursor: pointer;
	}

	.dismiss:hover {
		color: var(--color-text);
		background: var(--color-canvas);
	}
</style>
