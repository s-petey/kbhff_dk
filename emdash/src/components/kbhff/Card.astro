---
/** Shared surface for sidebar boxes and list items. */
interface Props {
	as?: "section" | "aside" | "header";
	/** `warning` for caution notices (amber), `danger` for errors and closures (red). */
	tone?: "default" | "brand" | "warning" | "danger";
}

const { as: Tag = "section", tone = "default" } = Astro.props;
---

<Tag class:list={["card", tone]}>
	<slot />
</Tag>

<style>
	/* A card is a vertical stack: children are spaced by gap, not margins. */
	.card {
		display: grid;
		gap: 0.75rem;
		align-content: start;
		padding: clamp(1.1rem, 3vw, 1.5rem);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}

	.brand {
		background: var(--color-brand-soft);
		border-color: color-mix(in srgb, var(--color-brand) 18%, transparent);
	}

	.warning {
		background: var(--color-warning-soft);
		border-color: color-mix(in srgb, var(--color-warning) 30%, transparent);
	}

	.danger {
		background: var(--color-danger-soft);
		border-color: color-mix(in srgb, var(--color-danger) 22%, transparent);
	}

	.card > :global(*) {
		margin-block: 0;
	}

	.card > :global(h2),
	.card > :global(h3) {
		font-size: 1.1rem;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}
</style>
