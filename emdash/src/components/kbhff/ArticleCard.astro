---
import { formatDate, resolveLocale, type Locale } from "../../i18n";

interface Props {
	href: string;
	title: string;
	excerpt?: string | null;
	date?: Date | null;
	tags?: string[];
	/** Plain image URL. For EmDash image fields, pass `<Image />` in the `media` slot instead. */
	imageSrc?: string;
	imageAlt?: string;
	locale?: Locale;
}

const {
	href,
	title,
	excerpt,
	date,
	tags = [],
	imageSrc,
	imageAlt = "",
	locale = resolveLocale(Astro.currentLocale),
} = Astro.props;
const hasMedia = Astro.slots.has("media") || Boolean(imageSrc);
const dateLabel = date ? formatDate(locale, date) : undefined;
---

<article class="article-card">
	{
		hasMedia && (
			<div class="media">
				<slot name="media">
					<img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
				</slot>
			</div>
		)
	}
	<div class="body">
		{
			tags.length > 0 && (
				<ul class="tags">
					{tags.map((tag) => (
						<li>{tag}</li>
					))}
				</ul>
			)
		}
		<h3><a href={href}>{title}</a></h3>
		{dateLabel && <time datetime={date?.toISOString()}>{dateLabel}</time>}
		{excerpt && <p>{excerpt}</p>}
	</div>
</article>

<style>
	/* Media on top, body below: a vertical stack, so grid. */
	.article-card {
		position: relative;
		display: grid;
		align-content: start;
		overflow: hidden;
		height: 100%;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		transition:
			border-color 140ms ease,
			transform 140ms ease;
	}

	.article-card:hover {
		border-color: var(--color-brand);
	}

	.article-card:focus-within {
		outline: 3px solid var(--color-focus);
		outline-offset: 3px;
	}

	.media :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.body {
		display: grid;
		gap: 0.4rem;
		padding: 1.1rem 1.25rem 1.35rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		color: var(--color-brand);
		background: var(--color-brand-soft);
		font-size: 0.78rem;
		font-weight: 650;
	}

	h3 {
		margin: 0;
		font-size: 1.15rem;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	h3 a {
		color: var(--color-text);
		text-decoration: none;
	}

	/* Whole card is clickable via the heading link. */
	h3 a::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	h3 a:focus-visible {
		outline: none;
	}

	time {
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}

	p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.95rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.article-card:hover {
			transform: translateY(-2px);
		}
	}
</style>
