---
import type { HTMLAttributes } from "astro/types";

/**
 * A link styled as a button when `href` is set, otherwise a real `<button>`
 * (`type="button"` unless `type` is given, e.g. `submit` in a dialog form).
 * Other attributes (aria-*, data-*, commandfor/command) pass through.
 * `aria-pressed="true"` or `aria-current` shows the selected state.
 */
interface Props extends Omit<HTMLAttributes<"button">, "class"> {
	href?: string;
	/** `warning` for caution (amber), `danger` for destructive or error actions (red). */
	variant?: "primary" | "secondary" | "warning" | "danger";
	size?: "md" | "sm";
}

const { href, variant = "primary", size = "md", type = "button", ...attrs } = Astro.props;
const className = ["button", variant, size];
---

{
	href ? (
		<a class:list={className} href={href} {...attrs}>
			<slot />
		</a>
	) : (
		<button class:list={className} type={type} {...attrs}>
			<slot />
		</button>
	)
}

<style>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.6rem 1.15rem;
		border: 1px solid transparent;
		border-radius: 999px;
		font: inherit;
		font-weight: 650;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color 140ms ease,
			border-color 140ms ease,
			color 140ms ease;
	}

	.sm {
		min-height: 2.25rem;
		padding: 0.4rem 0.9rem;
		font-size: 0.9rem;
	}

	.primary {
		color: var(--color-on-brand);
		background: var(--color-brand);
	}

	.primary:hover {
		background: var(--color-brand-hover);
	}

	.secondary {
		color: var(--color-brand);
		background: var(--color-surface);
		border-color: var(--color-border);
	}

	.secondary:hover {
		color: var(--color-brand-hover);
		border-color: var(--color-brand);
	}

	.warning {
		color: var(--color-on-warning);
		background: var(--color-warning);
	}

	.warning:hover {
		background: var(--color-warning-hover);
	}

	.danger {
		color: var(--color-on-danger);
		background: var(--color-danger);
	}

	.danger:hover {
		background: var(--color-danger-hover);
	}

	/* Selected state for toggle groups and current-page links. */
	.button[aria-pressed="true"],
	.button[aria-current]:not([aria-current="false"]) {
		color: var(--color-on-brand);
		background: var(--color-brand);
		border-color: var(--color-brand);
	}
</style>
