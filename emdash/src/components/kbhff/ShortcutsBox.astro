---
import { getMessages, resolveLocale, type Locale } from "../../i18n";
import { legacyAppUrl } from "../../utils/legacy-app";
import Button from "./Button.astro";
import Card from "./Card.astro";

type Shortcut = "takeShift" | "orderBag" | "becomeMember" | "logIn";

interface Props {
	/** The Astro site does not know the PHP session, so the caller chooses which links to show. */
	audience?: "guest" | "member";
	/** Override link targets; defaults point into the PHP member system. */
	hrefs?: Partial<Record<Shortcut, string>>;
	locale?: Locale;
}

const { audience = "guest", hrefs = {}, locale = resolveLocale(Astro.currentLocale) } = Astro.props;
const t = getMessages(locale).shortcuts;

const defaultHrefs: Record<Shortcut, string> = {
	takeShift: legacyAppUrl("/medlem/tag-en-vagt"),
	orderBag: legacyAppUrl("/butik"),
	becomeMember: legacyAppUrl("/bliv-medlem"),
	logIn: legacyAppUrl("/login"),
};
const shortcuts: Shortcut[] = audience === "member" ? ["takeShift", "orderBag"] : ["becomeMember", "logIn"];
const links = shortcuts.map((key) => ({ label: t[key], href: hrefs[key] ?? defaultHrefs[key] }));
---

<Card as="aside" tone="brand">
	<h2>{t.title}</h2>
	<ul>
		{
			links.map((link, index) => (
				<li>
					<Button href={link.href} variant={index === 0 ? "primary" : "secondary"}>
						{link.label}
					</Button>
				</li>
			))
		}
	</ul>
</Card>

<style>
	ul {
		display: grid;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	ul :global(.button) {
		width: 100%;
	}
</style>
