---
/**
 * Site header: brand, main navigation, search, theme choice and the language
 * link. See "Site header" in design-docs/20-KBHFF-DESIGN-SYSTEM-PLAN.md.
 *
 * - Wide screens (≥ 64rem): everything inline.
 * - Narrow screens: brand, language link and a "Menu" button; the menu panel
 *   (navigation, search, theme) opens below the bar.
 * - The menu button is a disclosure (`aria-expanded`), not a dialog: no focus
 *   trap, Escape closes it and returns focus to the button.
 * - The language link stays visible on every screen size.
 * - Without JavaScript the menu stays open and the button is hidden.
 *
 * DOM order is brand → menu button → menu → language link, so focus moves
 * from the button straight into the opened menu.
 */
import LiveSearch from "emdash/ui/search";
import { getMessages, type Locale } from "../../i18n";
import { homePath, type LanguageLinkTarget } from "../../i18n/routes";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import LanguageLink from "./LanguageLink.astro";
import ThemeSelect from "./ThemeSelect.astro";

interface MenuLink {
	label: string;
	url: string;
	target?: string | null;
}

interface Props {
	siteTitle: string;
	siteLogo: { url?: string; alt?: string } | null;
	links: MenuLink[];
	locale: Locale;
	/** Where the language link points; set by the page through Base. */
	languageLink: LanguageLinkTarget;
}

const { siteTitle, siteLogo, links, locale, languageLink } = Astro.props;
const t = getMessages(locale);
// Menu URLs may or may not end in "/" ("/en/" vs "/en"); compare without it.
const withoutTrailingSlash = (path: string) => (path.length > 1 ? path.replace(/\/$/, "") : path);
const currentPath = withoutTrailingSlash(Astro.url.pathname);
---

<header class="site-header" data-site-header>
	<div class="bar">
		<a class="brand" href={homePath(locale)}>
			{siteLogo?.url ? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} /> : siteTitle}
		</a>

		<div class="menu-toggle">
			<Button variant="secondary" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
				<Icon name="menu" size={20} />
				<span>{t.header.menu}</span>
			</Button>
		</div>

		<div class="menu" id="site-menu">
			<nav aria-label={t.header.mainNavigation}>
				<ul>
					{
						links.map((link) => (
							<li>
								<a
									href={link.url}
									target={link.target || undefined}
									rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
									aria-current={withoutTrailingSlash(link.url) === currentPath ? "page" : undefined}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<LiveSearch placeholder={t.common.search} collections={["posts", "pages"]} locale={locale} />
			<ThemeSelect locale={locale} />
		</div>

		<div class="language">
			<LanguageLink locale={languageLink.locale} href={languageLink.href} />
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");

	if (header && toggle) {
		const setOpen = (open: boolean) => {
			header.dataset.menu = open ? "open" : "closed";
			toggle.setAttribute("aria-expanded", String(open));
		};

		// With JavaScript the menu starts closed and the button appears.
		setOpen(false);

		toggle.addEventListener("click", () => setOpen(header.dataset.menu !== "open"));

		header.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && header.dataset.menu === "open") {
				setOpen(false);
				toggle.focus();
			}
		});
	}
</script>

<style>
	.site-header {
		background: var(--color-surface);
		border-block-end: 1px solid var(--color-border);
	}

	/* Narrow layout: brand, language and menu button in one row; the menu panel below. */
	.bar {
		display: grid;
		grid-template-areas:
			"brand language toggle"
			"menu menu menu";
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: 0 0.5rem;
		width: min(var(--content-width), 100% - 2rem);
		min-height: 4rem;
		margin-inline: auto;
	}

	.brand {
		grid-area: brand;
		justify-self: start;
		color: var(--color-text);
		font-size: 1.15rem;
		font-weight: 750;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand img {
		display: block;
		height: 3rem;
		width: auto;
	}

	.language {
		grid-area: language;
	}

	.menu-toggle {
		grid-area: toggle;
	}

	/* Without JavaScript there is no way to open the menu, so it stays open. */
	.site-header:not([data-menu]) .menu-toggle {
		display: none;
	}

	.menu {
		grid-area: menu;
		display: grid;
		gap: 1rem;
		padding-block: 0.5rem 1.25rem;
		border-block-start: 1px solid var(--color-border);
	}

	nav ul {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		display: block;
		padding-block: 0.75rem;
		border-block-end: 1px solid var(--color-border);
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current="page"] {
		color: var(--color-brand);
	}

	.menu :global(.emdash-live-search) {
		display: block;
		width: 100%;
	}

	.menu :global(.emdash-live-search-input) {
		width: 100%;
		min-height: 2.75rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text);
		background: var(--color-canvas);
		font: inherit;
	}

	@media (width < 64rem) {
		.site-header[data-menu="closed"] .menu {
			display: none;
		}
	}

	/* Wide layout: brand | navigation, search, theme | language. */
	@media (width >= 64rem) {
		.bar {
			grid-template-areas: "brand menu language";
			grid-template-columns: auto 1fr auto;
			gap: clamp(1rem, 2vw, 2rem);
			min-height: 5rem;
		}

		.menu-toggle {
			display: none;
		}

		.menu {
			display: flex;
			align-items: center;
			gap: clamp(0.75rem, 1.5vw, 1.5rem);
			padding: 0;
			border: 0;
		}

		nav {
			margin-inline-end: auto;
		}

		nav ul {
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem clamp(0.75rem, 1.5vw, 1.5rem);
		}

		nav a {
			padding-block: 0.4rem;
			border: 0;
			font-size: 0.95rem;
		}

		.menu :global(.emdash-live-search) {
			width: 14rem;
		}
	}
</style>
