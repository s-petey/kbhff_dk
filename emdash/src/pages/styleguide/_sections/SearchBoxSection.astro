---
import SearchBox from "../../../components/kbhff/SearchBox.astro";
import type { Locale } from "../../../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<p class="lead">
	In the site header. Submitting opens the news list in the page's language. On the news list the header box shows the
	current search and keeps the active category and tag filters.
</p>

<h3>Empty</h3>
<SearchBox locale={locale} />

<h3>Pre-filled (header on the news list)</h3>
<SearchBox locale={locale} filters={{ search: locale === "da" ? "grøntsager" : "vegetables" }} />
