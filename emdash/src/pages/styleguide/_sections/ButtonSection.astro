---
import Button from "../../../components/kbhff/Button.astro";
import ImageButton from "../../../components/kbhff/ImageButton.astro";
import Icon from "../../../components/kbhff/Icon.astro";
import stamp from "../../../components/kbhff-stamp.webp";
import type { Locale } from "../../../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const text = {
	en: {
		primary: "Primary",
		secondary: "Secondary",
		warning: "Warning",
		danger: "Danger",
		small: "Small",
		link: "Link (with href)",
		button: "Button (no href)",
		withIcon: "With icon",
		pressed: "Pressed",
		notPressed: "Not pressed",
		expanded: "Expanded",
		current: "Current page",
	},
	da: {
		primary: "Primær",
		secondary: "Sekundær",
		warning: "Advarsel",
		danger: "Fare",
		small: "Lille",
		link: "Link (med href)",
		button: "Knap (uden href)",
		withIcon: "Med ikon",
		pressed: "Valgt",
		notPressed: "Ikke valgt",
		expanded: "Åben",
		current: "Aktuel side",
	},
}[locale];
---

<h3>Variants and sizes</h3>
<div class="cluster">
	<Button href="#button">{text.primary}</Button>
	<Button href="#button" variant="secondary">{text.secondary}</Button>
	<Button href="#button" variant="warning">{text.warning}</Button>
	<Button href="#button" variant="danger">{text.danger}</Button>
	<Button href="#button" size="sm">{text.small}</Button>
	<Button href="#button" variant="secondary" size="sm">{text.small}</Button>
</div>

<h3>Link or button</h3>
<p class="lead">
	With <code>href</code> it renders <code>&lt;a&gt;</code>; without it, <code>&lt;button type="button"&gt;</code> (or
	<code>type="submit"</code> when given). Other attributes such as <code>aria-*</code>, <code>data-*</code> and
	<code>commandfor</code> pass through.
</p>
<div class="cluster">
	<Button href="#button" variant="secondary">{text.link}</Button>
	<Button variant="secondary">{text.button}</Button>
	<Button variant="secondary">
		<Icon name="menu" size={20} />
		<span>{text.withIcon}</span>
	</Button>
</div>

<h3>Selected states</h3>
<p class="lead">
	<code>aria-pressed="true"</code> (toggle buttons), <code>aria-expanded="true"</code> (open disclosures such as the
	header's Menu button) and <code>aria-current</code> (current-page links) all show the selected style.
</p>
<div class="cluster">
	<Button variant="secondary" aria-pressed="false">{text.notPressed}</Button>
	<Button variant="secondary" aria-pressed="true">{text.pressed}</Button>
	<Button variant="secondary" aria-expanded="true">{text.expanded}</Button>
	<Button href="#button" variant="secondary" aria-current="page">{text.current}</Button>
</div>

<h3>Image buttons</h3>
<p class="lead">
	Use <code>ImageButton</code> for an image-based action or link. The image is cropped to a circle; provide a concise
	<code>label</code> for its accessible name.
</p>
<div class="cluster">
	<ImageButton src={stamp} label="Open Copenhagen food community" href="#button" />
	<ImageButton src={stamp} label="Select image" size="sm" aria-pressed="true" />
	<ImageButton src={stamp} label="Disabled image button" size="lg" disabled />
</div>
