---
import Banner from "../../../components/kbhff/Banner.astro";
import Button from "../../../components/kbhff/Button.astro";
import type { Locale } from "../../../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const text = {
	en: { heading: "Welcome to KBHFF", subheading: "Local, organic vegetables at a fair price.", action: "Become a member" },
	da: { heading: "Velkommen til KBHFF", subheading: "Lokale, økologiske grøntsager til en fair pris.", action: "Bliv medlem" },
}[locale];
---

<p class="lead">Random photo per request when <code>photo</code> is omitted.</p>

<Banner photo={1} />

<Banner photo={3} heading={text.heading} subheading={text.subheading}>
	<Button href="#banner">{text.action}</Button>
</Banner>
