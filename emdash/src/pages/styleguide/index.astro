---
/**
 * Component gallery for the KBHFF components in src/components/kbhff.
 * Available in `astro dev`, and in production to logged-in EmDash admins
 * only; everyone else gets the 404 page. The page chrome is English (dev
 * tooling); `?lang=` switches the components' interface language and the
 * sample content. The switch is the site header's language link, as on
 * every other page; this page only tells it where to point.
 *
 * Each section lives in ./_sections/<Title>Section.astro with its own markup
 * and placeholder content; `groups` below drives both the navigation and the
 * page. Naming: plain-language, sentence-case titles ("Article card"); the
 * exact component names go in `components`; the anchor is derived from the
 * title. Foundations first, then components in alphabetical order.
 * See design-docs/20-KBHFF-DESIGN-SYSTEM-PLAN.md.
 */
import Button from "../../components/kbhff/Button.astro";
import Card from "../../components/kbhff/Card.astro";
import { devLocale, localeNames, otherLocale, resolveLocale } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { canViewAdminTools } from "../../utils/admin-access";
import Section from "./_components/Section.astro";
import ArticleCardSection from "./_sections/ArticleCardSection.astro";
import BannerSection from "./_sections/BannerSection.astro";
import ButtonSection from "./_sections/ButtonSection.astro";
import CardSection from "./_sections/CardSection.astro";
import ColoursSection from "./_sections/ColoursSection.astro";
import DepartmentCardSection from "./_sections/DepartmentCardSection.astro";
import DialogSection from "./_sections/DialogSection.astro";
import FaqGroupSection from "./_sections/FaqGroupSection.astro";
import IconsSection from "./_sections/IconsSection.astro";
import LanguageBannerSection from "./_sections/LanguageBannerSection.astro";
import LayoutSection from "./_sections/LayoutSection.astro";
import SidebarBoxesSection from "./_sections/SidebarBoxesSection.astro";
import SiteHeaderSection from "./_sections/SiteHeaderSection.astro";
import StepsSection from "./_sections/StepsSection.astro";
import TypographySection from "./_sections/TypographySection.astro";

if (!canViewAdminTools(Astro.locals)) {
	return Astro.rewrite("/404");
}

// Admin-only output must never be cached or indexed.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const locale = resolveLocale(Astro.url.searchParams.get("lang"), devLocale);
const alternateLocale = otherLocale(locale);

// `localized`: the section shows sample content in the selected language.
const groups = [
	{
		title: "Foundations",
		sections: [
			{ title: "Colours", Body: ColoursSection, localized: false },
			{ title: "Typography", Body: TypographySection, localized: true },
			{ title: "Layout", Body: LayoutSection, localized: false },
			{ title: "Icons", components: ["Icon"], Body: IconsSection, localized: false },
		],
	},
	{
		title: "Components",
		sections: [
			{ title: "Article card", components: ["ArticleCard"], Body: ArticleCardSection, localized: true },
			{ title: "Banner", components: ["Banner"], Body: BannerSection, localized: true },
			{ title: "Button", components: ["Button"], Body: ButtonSection, localized: true },
			{ title: "Card", components: ["Card"], Body: CardSection, localized: true },
			{ title: "Department card", components: ["DepartmentCard"], Body: DepartmentCardSection, localized: true },
			{ title: "Dialog", components: ["Dialog"], Body: DialogSection, localized: true },
			{ title: "FAQ group", components: ["FaqGroup"], Body: FaqGroupSection, localized: true },
			{ title: "Language banner", components: ["LanguageBanner"], Body: LanguageBannerSection, localized: false },
			{
				title: "Sidebar boxes",
				components: ["ShortcutsBox", "NewsletterBox", "WeeklyBagBox"],
				Body: SidebarBoxesSection,
				localized: true,
			},
			{
				title: "Site header",
				components: ["SiteHeader", "LanguageLink", "ThemeSelect", "ThemeScript"],
				Body: SiteHeaderSection,
				localized: true,
			},
			{ title: "Steps", components: ["Steps"], Body: StepsSection, localized: true },
		],
	},
].map((group) => ({
	...group,
	// Anchor from the title: "Article card" → "article-card".
	sections: group.sections.map((section) => ({ ...section, id: section.title.toLowerCase().replaceAll(" ", "-") })),
}));
---

<Base
	title="Styleguide"
	description="KBHFF component gallery (admin only)"
	locale={devLocale}
	languageLink={{ locale: alternateLocale, href: `?lang=${alternateLocale}` }}
>
	<div class="stack styleguide" data-styleguide-samples>
		<Card as="header">
			<div class="stack intro">
				<div class="stack heading">
					<p class="eyebrow">Admin tooling · sample data</p>
					<h1>KBHFF styleguide</h1>
				</div>
				<p class="lead">
					Components from <code>src/components/kbhff</code>, rendered with placeholder content and the site's real CSS.
					Names, addresses and text are invented examples, not KBHFF content. Sample links point at their own section
					and sample forms do not submit. Use the site header to switch theme and language, as on every other page.
				</p>
				<p class="text-small text-muted">
					Components and sample content: <strong lang={locale}>{localeNames[locale]}</strong>
				</p>

				<nav class="stack toc" aria-label="Styleguide sections">
					{
						groups.map((group) => (
							<div class="cluster group">
								<span class="text-small text-muted">{group.title}</span>
								{group.sections.map(({ id, title }) => (
									<Button href={`#${id}`} variant="secondary" size="sm">
										{title}
									</Button>
								))}
							</div>
						))
					}
				</nav>
			</div>
		</Card>

		{
			groups.flatMap((group) =>
				group.sections.map(({ id, title, components, Body, localized }) => (
					<Section id={id} title={title} components={components} lang={localized ? locale : undefined}>
						<Body locale={locale} />
					</Section>
				)),
			)
		}
	</div>
</Base>

<script>
	// Sample links point at in-page anchors. Forms are the exception: the
	// NewsletterBox posts to the live Mailchimp list, so sample forms do not
	// submit. Dialog forms (method="dialog") keep working.
	document.querySelector("[data-styleguide-samples]")?.addEventListener("submit", (event) => {
		if (event.target instanceof HTMLFormElement && event.target.method !== "dialog") event.preventDefault();
	});
</script>

<style>
	/* Page-specific tuning of the layout primitives only. */
	.styleguide {
		--stack-gap: clamp(2.5rem, 6vw, 4rem);
	}

	.heading {
		--stack-gap: 0.25rem;
	}

	.toc {
		--stack-gap: 0.5rem;
	}

	.group {
		--cluster-gap: 0.35rem;
	}
</style>
