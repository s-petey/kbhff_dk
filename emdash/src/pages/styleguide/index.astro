---
/**
 * Component gallery for the KBHFF components in src/components/kbhff.
 * Available in `astro dev`, and in production to logged-in EmDash admins
 * only; everyone else gets the 404 page. The page chrome is English (dev
 * tooling); `?lang=` switches the components' interface language and the
 * sample content.
 *
 * Each section lives in ./_sections/ with its own markup and placeholder
 * content; `sections` below drives both the navigation and the page.
 * See design-docs/20-KBHFF-DESIGN-SYSTEM-PLAN.md.
 */
import Button from "../../components/kbhff/Button.astro";
import Card from "../../components/kbhff/Card.astro";
import { devLocale, localeNames, locales, resolveLocale } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { canViewAdminTools } from "../../utils/admin-access";
import Section from "./_components/Section.astro";
import Articles from "./_sections/Articles.astro";
import Banners from "./_sections/Banners.astro";
import Buttons from "./_sections/Buttons.astro";
import Cards from "./_sections/Cards.astro";
import Colours from "./_sections/Colours.astro";
import Departments from "./_sections/Departments.astro";
import Faq from "./_sections/Faq.astro";
import Layout from "./_sections/Layout.astro";
import SidebarBoxes from "./_sections/SidebarBoxes.astro";
import StepsSection from "./_sections/StepsSection.astro";
import Typography from "./_sections/Typography.astro";

if (!canViewAdminTools(Astro.locals)) {
	return Astro.rewrite("/404");
}

// Admin-only output must never be cached or indexed.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const locale = resolveLocale(Astro.url.searchParams.get("lang"), devLocale);

// `localized`: the section shows sample content in the selected language.
const sections = [
	{ id: "colours", title: "Colours", Body: Colours, localized: false },
	{ id: "layout", title: "Layout", Body: Layout, localized: false },
	{ id: "typography", title: "Typography", Body: Typography, localized: true },
	{ id: "buttons", title: "Button", Body: Buttons, localized: true },
	{ id: "cards", title: "Card", Body: Cards, localized: true },
	{ id: "banner", title: "Banner", Body: Banners, localized: true },
	{ id: "sidebar", title: "Sidebar boxes", Body: SidebarBoxes, localized: true },
	{ id: "articles", title: "ArticleCard", Body: Articles, localized: true },
	{ id: "steps", title: "Steps", Body: StepsSection, localized: true },
	{ id: "departments", title: "DepartmentCard", Body: Departments, localized: true },
	{ id: "faq", title: "FaqGroup", Body: Faq, localized: true },
];
---

<Base title="Styleguide" description="KBHFF component gallery (admin only)" locale={devLocale}>
	<div class="stack styleguide">
		<Card as="header">
			<div class="stack intro">
				<div class="stack heading">
					<p class="eyebrow">Admin tooling · sample data</p>
					<h1>KBHFF styleguide</h1>
				</div>
				<p class="lead">
					Components from <code>src/components/kbhff</code>, rendered with placeholder content and the site's real CSS.
					Names, addresses and text are invented examples, not KBHFF content.
				</p>

				<div class="cluster controls">
					<div class="cluster group" role="group" aria-label="Component language">
						<span class="text-small text-muted">Language</span>
						{
							locales.map((code) => (
								<Button
									href={`?lang=${code}`}
									variant="secondary"
									size="sm"
									aria-current={code === locale ? "true" : undefined}
								>
									{localeNames[code]}
								</Button>
							))
						}
					</div>
					<div class="cluster group" role="group" aria-label="Colour theme">
						<span class="text-small text-muted">Theme</span>
						<Button variant="secondary" size="sm" data-theme-choice="system">System</Button>
						<Button variant="secondary" size="sm" data-theme-choice="light">Light</Button>
						<Button variant="secondary" size="sm" data-theme-choice="dark">Dark</Button>
					</div>
				</div>

				<nav class="cluster group" aria-label="Styleguide sections">
					{
						sections.map(({ id, title }) => (
							<Button href={`#${id}`} variant="secondary" size="sm">
								{title}
							</Button>
						))
					}
				</nav>
			</div>
		</Card>

		{
			sections.map(({ id, title, Body, localized }) => (
				<Section id={id} title={title} lang={localized ? locale : undefined}>
					<Body locale={locale} />
				</Section>
			))
		}
	</div>
</Base>

<script>
	// Preview-only theme switch: sets data-theme on <html>, remembered per browser.
	const STORAGE_KEY = "kbhff-styleguide-theme";
	const root = document.documentElement;
	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");

	function apply(choice: string) {
		if (choice === "light" || choice === "dark") root.dataset.theme = choice;
		else delete root.dataset.theme;
		buttons.forEach((button) =>
			button.setAttribute("aria-pressed", String(button.dataset.themeChoice === choice)),
		);
	}

	let saved = "system";
	try {
		saved = localStorage.getItem(STORAGE_KEY) ?? "system";
	} catch {
		// Storage can be unavailable (private mode, blocked site data).
	}
	apply(saved);

	buttons.forEach((button) =>
		button.addEventListener("click", () => {
			const choice = button.dataset.themeChoice ?? "system";
			apply(choice);
			try {
				localStorage.setItem(STORAGE_KEY, choice);
			} catch {
				// Ignore; the choice still applies for this page view.
			}
		}),
	);
</script>

<style>
	/* Page-specific tuning of the layout primitives only. */
	.styleguide {
		--stack-gap: clamp(2.5rem, 6vw, 4rem);
	}

	.heading {
		--stack-gap: 0.25rem;
	}

	.controls {
		--cluster-gap: 0.75rem 1.5rem;
	}

	.group {
		--cluster-gap: 0.35rem;
	}
</style>
