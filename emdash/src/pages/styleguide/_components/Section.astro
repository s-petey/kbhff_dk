---
/**
 * Wrapper for one styleguide section: anchor id, heading and even spacing.
 * Section bodies (../_sections/*.astro) render their content as direct
 * children of this stack.
 */
interface Props {
	id: string;
	title: string;
	/** Language of the sample content, when it differs from the page. */
	lang?: string;
}

const { id, title, lang } = Astro.props;
---

<section id={id} lang={lang} class="stack">
	<h2>{title}</h2>
	<slot />
</section>

<style>
	h2 {
		padding-block-end: 0.5rem;
		border-block-end: 1px solid var(--color-border);
	}

	section > :global(h3) {
		margin-block-start: 0.5rem;
	}
</style>
