---
/**
 * Wrapper for one styleguide section: anchor id, heading, the component
 * names it documents, and even spacing. Section bodies
 * (../_sections/*.astro) render their content as direct children of this stack.
 */
interface Props {
	id: string;
	/** Plain-language, sentence-case title, e.g. "Article card". */
	title: string;
	/** Exact component names shown in this section, e.g. ["ArticleCard"]. */
	components?: string[];
	/** Language of the sample content, when it differs from the page. */
	lang?: string;
}

const { id, title, components = [], lang } = Astro.props;
---

<section id={id} lang={lang} class="stack">
	<div class="heading">
		<h2>{title}</h2>
		{
			components.length > 0 && (
				<p class="text-small text-muted" lang="en">
					{components.length === 1 ? "Component" : "Components"}:{" "}
					{components.map((name, index) => (
						<>
							{index > 0 && ", "}
							<code>{name}</code>
						</>
					))}
				</p>
			)
		}
	</div>
	<slot />
</section>

<style>
	.heading {
		display: grid;
		gap: 0.25rem;
		padding-block-end: 0.5rem;
		border-block-end: 1px solid var(--color-border);
	}

	.heading > * {
		margin: 0;
	}

	section > :global(h3) {
		margin-block-start: 0.5rem;
	}
</style>
