---
import "../styles/theme.css";
import "../styles/layout.css";
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LanguageBanner from "../components/kbhff/LanguageBanner.astro";
import SiteHeader from "../components/kbhff/SiteHeader.astro";
import ThemeScript from "../components/kbhff/ThemeScript.astro";
import { otherLocale, resolveLocale, type Locale } from "../i18n";
import { homePath, type LanguageLinkTarget, type NewsFilters } from "../i18n/routes";
import type { Alternate } from "../i18n/translations";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import kbhffStamp from "../components/kbhff-stamp.webp?url";
import kbhffStampDark from "../components/kbhff-stamp-dark.webp?url";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** `robots` from `getSeoMeta()` ("noindex, nofollow" when hidden from search engines). */
	robots?: string | null;
	/**
	 * Content reference: plugin page contributions, the SEO panel overlay and
	 * EmDash's hreflang links. News items leave it out and pass `alternates`
	 * instead, since EmDash would build `/en/nyheder/…` URLs.
	 */
	content?: { collection: string; id: string; slug?: string | null };
	/** hreflang alternates to render instead of EmDash's (see src/i18n/translations.ts). */
	alternates?: Alternate[];
	/** Interface language; defaults to the request locale, then the site default. */
	locale?: Locale;
	/**
	 * Where the language link and language banner point: the same page in the
	 * other language. Views set it (see src/i18n/routes.ts); defaults to the
	 * other language's home page.
	 */
	languageLink?: LanguageLinkTarget;
	/** News list only: fills in the header search box and keeps the active filters (see SearchBox). */
	searchFilters?: NewsFilters;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	content,
	alternates = [],
	locale = resolveLocale(Astro.currentLocale),
	languageLink = { locale: otherLocale(locale), href: homePath(otherLocale(locale)) },
	searchFilters,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary", { locale }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	seo: robots ? { robots } : undefined,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		
		<ThemeScript />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		

		<link rel="icon" href={kbhffStamp} type="image/webp" />
        <link
            rel="icon"
            href={kbhffStamp}
            type="image/webp"
            media="(prefers-color-scheme: light)"
        />
        <link
            rel="icon"
            href={kbhffStampDark}
            type="image/webp"
            media="(prefers-color-scheme: dark)"
        />

		{alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<SiteHeader
			siteTitle={siteTitle}
			siteLogo={siteLogo}
			links={menu?.items ?? []}
			locale={locale}
			languageLink={languageLink}
			searchFilters={searchFilters}
		/>

		<main>
			<slot />
		</main>

		<LanguageBanner pageLocale={locale} languageLink={languageLink} />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
