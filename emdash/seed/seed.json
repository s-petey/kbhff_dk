{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "KBHFF starter",
		"description": "Posts and pages in Danish (default) with linked English translations",
		"author": "KBHFF"
	},
	"defaultLocale": "da",
	"settings": {
		"title": "KBHFF",
		"tagline": "Københavns Fødevarefællesskab"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/nyheder/{slug}",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"id": "tax:category:da",
			"name": "category",
			"label": "Kategorier",
			"labelSingular": "Kategori",
			"hierarchical": true,
			"collections": ["posts"],
			"locale": "da",
			"terms": [
				{ "id": "term:category:generelt:da", "slug": "generelt", "label": "Generelt", "locale": "da" },
				{ "id": "term:category:opdateringer:da", "slug": "opdateringer", "label": "Opdateringer", "locale": "da" }
			]
		},
		{
			"id": "tax:category:en",
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"locale": "en",
			"translationOf": "tax:category:da",
			"terms": [
				{
					"id": "term:category:general:en",
					"slug": "general",
					"label": "General",
					"locale": "en",
					"translationOf": "term:category:generelt:da"
				},
				{
					"id": "term:category:updates:en",
					"slug": "updates",
					"label": "Updates",
					"locale": "en",
					"translationOf": "term:category:opdateringer:da"
				}
			]
		},
		{
			"id": "tax:tag:da",
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"locale": "da",
			"terms": [{ "id": "term:tag:eksempel:da", "slug": "eksempel", "label": "Eksempel", "locale": "da" }]
		},
		{
			"id": "tax:tag:en",
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"locale": "en",
			"translationOf": "tax:tag:da",
			"terms": [
				{
					"id": "term:tag:example:en",
					"slug": "example",
					"label": "Example",
					"locale": "en",
					"translationOf": "term:tag:eksempel:da"
				}
			]
		}
	],
	"menus": [
		{
			"id": "menu:primary:da",
			"name": "primary",
			"label": "Hovedmenu",
			"locale": "da",
			"items": [
				{ "type": "custom", "label": "Forside", "url": "/" },
				{ "type": "custom", "label": "Nyheder", "url": "/nyheder" },
				{ "type": "custom", "label": "Om KBHFF", "url": "/om" }
			]
		},
		{
			"id": "menu:primary:en",
			"name": "primary",
			"label": "Main navigation",
			"locale": "en",
			"translationOf": "menu:primary:da",
			"items": [
				{ "type": "custom", "label": "Home", "url": "/en/" },
				{ "type": "custom", "label": "News", "url": "/en/news" },
				{ "type": "custom", "label": "About KBHFF", "url": "/en/about" }
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5
					}
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "om",
				"slug": "om",
				"status": "published",
				"locale": "da",
				"data": {
					"title": "Om KBHFF",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k0",
							"children": [
								{
									"_type": "span",
									"_key": "k1",
									"text": "Eksempelside. Rediger den i administrationen. Den engelske oversættelse er koblet til denne side."
								}
							]
						}
					]
				}
			},
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"locale": "en",
				"translationOf": "om",
				"data": {
					"title": "About KBHFF",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k0",
							"children": [
								{
									"_type": "span",
									"_key": "k1",
									"text": "Example page. Edit it in the admin. It is linked as the English translation of the Danish page."
								}
							]
						}
					]
				}
			},
			{
				"id": "nyheder",
				"slug": "nyheder",
				"status": "published",
				"locale": "da",
				"data": {
					"title": "Nyheder",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k0",
							"children": [
								{
									"_type": "span",
									"_key": "k1",
									"text": "Titel og intro til nyhedslisten på /nyheder. Rediger dem i administrationen."
								}
							]
						}
					]
				}
			},
			{
				"id": "news",
				"slug": "news",
				"status": "published",
				"locale": "en",
				"translationOf": "nyheder",
				"data": {
					"title": "News",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k0",
							"children": [
								{
									"_type": "span",
									"_key": "k1",
									"text": "Title and intro for the news list at /en/news. Edit them in the admin."
								}
							]
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "velkommen",
				"slug": "velkommen",
				"status": "published",
				"locale": "da",
				"data": {
					"title": "Velkommen",
					"excerpt": "Eksempelnyhed. Erstat den med rigtigt indhold.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k0",
							"children": [
								{
									"_type": "span",
									"_key": "k1",
									"text": "Eksempelnyhed på dansk. Den engelske oversættelse har sin egen slug, men er koblet til denne."
								}
							]
						}
					]
				},
				"taxonomies": {
					"category": ["generelt"],
					"tag": ["eksempel"]
				}
			},
			{
				"id": "welcome",
				"slug": "welcome",
				"status": "published",
				"locale": "en",
				"translationOf": "velkommen",
				"data": {
					"title": "Welcome",
					"excerpt": "Example news item. Replace it with real content.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "k0",
							"children": [
								{
									"_type": "span",
									"_key": "k1",
									"text": "Example news item in English. It has its own slug but is linked to the Danish version."
								}
							]
						}
					]
				},
				"taxonomies": {
					"category": ["general"],
					"tag": ["example"]
				}
			}
		]
	}
}
